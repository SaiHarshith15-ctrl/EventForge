# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/eventforge

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# Cloudinary (image uploads for events/venues/avatars)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (nodemailer - used for booking confirmations, invites, password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=EventForge <no-reply@eventforge.com>

# Razorpay (payments - INR/UPI)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# AI Assistant (optional - falls back to built-in rule-based assistant if not set)
OPENAI_API_KEY=
